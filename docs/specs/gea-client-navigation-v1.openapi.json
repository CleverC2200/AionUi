{
  "openapi": "3.1.0",
  "info": {
    "title": "GEA Client Navigation Reference API",
    "version": "1.0.0",
    "description": "GEA management-plane intent issuance and resolution, plus the local AionCore resolver consumed by AionUi. This checked-in contract is validated against a simulator; production adoption is still pending."
  },
  "paths": {
    "/api/v1/internal/client-navigation-intents": {
      "post": {
        "summary": "Issue an opaque client-navigation intent",
        "security": [{ "ServiceAuth": [] }],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/IssueIntentRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created or replayed idempotent result",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/IssueIntentResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/ai/gateway/client-navigation-intents/resolve": {
      "post": {
        "summary": "Resolve an intent under the current authenticated GEA identity",
        "description": "Read-only and replayable until expiry or revocation. The request must not supply identity or tenant overrides.",
        "security": [{ "GeaUserSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ManagementResolveRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized semantic target",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ManagementResolveResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/deep-links/resolve": {
      "post": {
        "summary": "Map a Navigation Reference to an authorized local Client Navigation Target",
        "description": "AionCore endpoint called by AionUi with the current Core Session. AionCore validates the linked external identity and performs the GEA-to-local mapping.",
        "security": [{ "CoreSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LocalResolveRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Closed typed local target",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LocalResolveResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceAuth": { "type": "http", "scheme": "bearer" },
      "GeaUserSession": { "type": "apiKey", "in": "cookie", "name": "gea_session" },
      "CoreSession": { "type": "apiKey", "in": "cookie", "name": "core_session" }
    },
    "responses": {
      "Error": {
        "description": "Stable failure envelope",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "Identifier": { "type": "string", "minLength": 1, "maxLength": 240 },
      "NavigationReference": {
        "type": "string",
        "minLength": 16,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9._~-]+$",
        "description": "Opaque; never log or interpret this value in the client."
      },
      "ExternalIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "issuer", "tenantId", "subject"],
        "properties": {
          "provider": { "const": "lark" },
          "issuer": { "$ref": "#/components/schemas/Identifier" },
          "tenantId": { "$ref": "#/components/schemas/Identifier" },
          "subject": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "IntentTarget": {
        "oneOf": [
          { "$ref": "#/components/schemas/ConversationSelector" },
          { "$ref": "#/components/schemas/MessageSelector" },
          { "$ref": "#/components/schemas/InteractionRequestSelector" },
          { "$ref": "#/components/schemas/TeamSelector" },
          { "$ref": "#/components/schemas/SlotSelector" }
        ],
        "discriminator": { "propertyName": "type" }
      },
      "ConversationSelector": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "assignmentId", "sessionId"],
        "properties": {
          "type": { "const": "conversation" },
          "assignmentId": { "$ref": "#/components/schemas/Identifier" },
          "sessionId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "MessageSelector": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "assignmentId", "sessionId", "messageId"],
        "properties": {
          "type": { "const": "message" },
          "assignmentId": { "$ref": "#/components/schemas/Identifier" },
          "sessionId": { "$ref": "#/components/schemas/Identifier" },
          "messageId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "InteractionRequestSelector": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "assignmentId", "sessionId", "interactionRequestId"],
        "properties": {
          "type": { "const": "interaction_request" },
          "assignmentId": { "$ref": "#/components/schemas/Identifier" },
          "sessionId": { "$ref": "#/components/schemas/Identifier" },
          "interactionRequestId": { "$ref": "#/components/schemas/Identifier" },
          "messageId": { "$ref": "#/components/schemas/Identifier" },
          "teamId": { "$ref": "#/components/schemas/Identifier" },
          "slotId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "TeamSelector": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "teamId"],
        "properties": {
          "type": { "const": "team" },
          "teamId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "SlotSelector": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "teamId", "slotId", "assignmentId", "sessionId"],
        "properties": {
          "type": { "const": "slot" },
          "teamId": { "$ref": "#/components/schemas/Identifier" },
          "slotId": { "$ref": "#/components/schemas/Identifier" },
          "assignmentId": { "$ref": "#/components/schemas/Identifier" },
          "sessionId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "IssueIntentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "recipient", "environmentKey", "target", "expiresInSeconds"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "recipient": { "$ref": "#/components/schemas/ExternalIdentity" },
          "environmentKey": { "$ref": "#/components/schemas/Identifier" },
          "target": { "$ref": "#/components/schemas/IntentTarget" },
          "expiresInSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 }
        }
      },
      "IssueIntentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "navigationReference", "clientUrl", "landingUrl", "expiresAt"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "navigationReference": { "$ref": "#/components/schemas/NavigationReference" },
          "clientUrl": { "type": "string", "pattern": "^aionui://open-conversation\\?ref=" },
          "landingUrl": { "type": "string", "format": "uri" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "ManagementResolveRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "navigationReference"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "navigationReference": { "$ref": "#/components/schemas/NavigationReference" }
        }
      },
      "ManagementResolveResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "environmentKey", "target", "expiresAt"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "environmentKey": { "$ref": "#/components/schemas/Identifier" },
          "target": { "$ref": "#/components/schemas/IntentTarget" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "traceId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "LocalResolveRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["navigation_reference", "schema_version"],
        "properties": {
          "navigation_reference": { "$ref": "#/components/schemas/NavigationReference" },
          "schema_version": { "const": 1 }
        }
      },
      "LocalResolveResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "target"],
        "properties": {
          "schema_version": { "const": 1 },
          "target": { "$ref": "#/components/schemas/LocalNavigationTarget" },
          "trace_id": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "LocalNavigationTarget": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "conversation_id", "assistant_id"],
            "properties": {
              "type": { "const": "conversation" },
              "conversation_id": { "$ref": "#/components/schemas/Identifier" },
              "assistant_id": { "$ref": "#/components/schemas/Identifier" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "conversation_id", "assistant_id", "message_id"],
            "properties": {
              "type": { "const": "message" },
              "conversation_id": { "$ref": "#/components/schemas/Identifier" },
              "assistant_id": { "$ref": "#/components/schemas/Identifier" },
              "message_id": { "$ref": "#/components/schemas/Identifier" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "conversation_id", "assistant_id", "interaction_request_id"],
            "properties": {
              "type": { "const": "interaction_request" },
              "conversation_id": { "$ref": "#/components/schemas/Identifier" },
              "assistant_id": { "$ref": "#/components/schemas/Identifier" },
              "interaction_request_id": { "$ref": "#/components/schemas/Identifier" },
              "message_id": { "$ref": "#/components/schemas/Identifier" },
              "team_id": { "$ref": "#/components/schemas/Identifier" },
              "slot_id": { "$ref": "#/components/schemas/Identifier" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "team_id"],
            "properties": {
              "type": { "const": "team" },
              "team_id": { "$ref": "#/components/schemas/Identifier" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "team_id", "slot_id", "conversation_id", "assistant_id"],
            "properties": {
              "type": { "const": "slot" },
              "team_id": { "$ref": "#/components/schemas/Identifier" },
              "slot_id": { "$ref": "#/components/schemas/Identifier" },
              "conversation_id": { "$ref": "#/components/schemas/Identifier" },
              "assistant_id": { "$ref": "#/components/schemas/Identifier" }
            }
          }
        ],
        "discriminator": { "propertyName": "type" }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "code", "error"],
        "properties": {
          "success": { "const": false },
          "code": {
            "enum": [
              "NAVIGATION_REFERENCE_EXPIRED",
              "NAVIGATION_REFERENCE_REVOKED",
              "NAVIGATION_REFERENCE_FORBIDDEN",
              "NAVIGATION_REFERENCE_NOT_FOUND",
              "NAVIGATION_SCHEMA_UNSUPPORTED",
              "DEEP_LINK_PROFILE_MISMATCH",
              "DEEP_LINK_ASSISTANT_MISMATCH",
              "DEEP_LINK_TARGET_NOT_FOUND"
            ]
          },
          "error": { "type": "string" },
          "trace_id": { "$ref": "#/components/schemas/Identifier" }
        }
      }
    }
  }
}
